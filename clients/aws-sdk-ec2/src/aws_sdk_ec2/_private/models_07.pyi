    """
    user_id_group_pairs: Sequence[UserIdGroupPair | UserIdGroupPairDict] | None
    """The security group and Amazon Web Services account ID pairs."""
    ip_ranges: Sequence[IpRange | IpRangeDict] | None
    """The IPv4 address ranges."""
