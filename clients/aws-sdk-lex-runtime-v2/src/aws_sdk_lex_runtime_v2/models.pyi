    Information about the value provided for a slot and Amazon Lex V2's
    interpretation.
    """

    original_value: str | None = ...
    """
    The part of the user's response to the slot elicitation that Amazon Lex
    V2 determines is relevant to the slot value.
    """
    interpreted_value: str
    """
    The value that Amazon Lex V2 determines for the slot, given the user
    input. The actual value depends on the setting of the value selection
    strategy for the bot. You can choose to use the value entered by the
    user, or you can have Amazon Lex V2 choose the first value in the
    `resolvedValues` list.
    """
    resolved_values: list[str] | None = ...
    """
    A list of values that Amazon Lex V2 determines are possible resolutions
    for the user input. The first value matches the `interpretedValue`.
    """

DELETE_SESSION: APIOperation[DeleteSessionInput, DeleteSessionOutput]
GET_SESSION: APIOperation[GetSessionInput, GetSessionOutput]
PUT_SESSION: APIOperation[PutSessionInput, PutSessionOutput]
RECOGNIZE_TEXT: APIOperation[RecognizeTextInput, RecognizeTextOutput]
RECOGNIZE_UTTERANCE: APIOperation[RecognizeUtteranceInput, RecognizeUtteranceOutput]
START_CONVERSATION: APIOperation[StartConversationInput, StartConversationOutput]
